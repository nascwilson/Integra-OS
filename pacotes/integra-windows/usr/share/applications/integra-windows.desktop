[Desktop Entry]
Type=Application
Name=Programa do Windows
Comment=Instala ou executa programas do Windows (.exe e .msi) em ambiente próprio
Exec=integra-windows %f
Icon=application-x-ms-dos-executable
Terminal=false
NoDisplay=true
