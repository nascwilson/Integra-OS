#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if command -v update-desktop-database >/dev/null; then
        update-desktop-database -q /usr/share/applications || true
    fi
    # aviso de atualizações leve, para todos os usuários
    systemctl --global enable integra-aviso-de-atualizacoes.timer >/dev/null 2>&1 || true
fi
exit 0
